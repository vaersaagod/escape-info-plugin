{% set diameter = diameter ?? 30 %}
{% set duration = duration ?? 1 %}
{% set strokeWidth = strokeWidth ?? 8 %}

<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="{{- diameter -}}px" height="{{- diameter -}}px" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid" style="width:{{- diameter -}}px;height:{{- diameter -}}px;stroke:currentColor;">
    <circle cx="50" cy="50" fill="none" stroke-width="{{ strokeWidth }}" r="35" stroke-dasharray="164.93361431346415 56.97787143782138" transform="rotate(47.4692 50 50)">
        <animateTransform attributeName="transform" type="rotate" repeatCount="indefinite" dur="{{- duration -}}s" values="0 50 50;360 50 50" keyTimes="0;1"></animateTransform>
    </circle>
</svg>
