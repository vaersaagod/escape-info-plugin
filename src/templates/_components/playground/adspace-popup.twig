{% if ads|length %}
    <div id="adspace-popup" class="tw-fixed tw-z-[9999999] tw-inset-0 tw-w-full tw-h-screen" data-ads="{{ ads|json_encode }}" style="display:none;">
        <div class="tw-absolute tw-w-[400px] tw-z-[2] tw-left-1/2 tw-top-1/2 tw--translate-x-1/2 tw--translate-y-1/2 tw-max-w-[90vw]">
            <button class="tw-flex tw-justify-center tw-items-center tw-block tw-w-[31px] tw-h-[31px] tw-p-[6px] tw-absolute tw-left-0 tw-top-0 tw--ml-[12px] tw--mt-[12px] tw-z-[2] tw-rounded-[100%] tw-appearance-none tw-bg-secondary overflow-hidden" data-playground-close aria-label="{{ 'Click to close'|t('escape-info') }}">
                <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="tw-block tw-w-full tw-h-full tw-flex-none"><path d="M1.3 18.586a.888.888 0 0 1-.627-1.515L17.071.673a.888.888 0 0 1 1.255 1.255L1.928 18.326a.885.885 0 0 1-.627.26Z" fill="#fff"/><path d="M17.698 18.586a.886.886 0 0 1-.627-.26L.673 1.928A.887.887 0 0 1 1.928.673l16.398 16.398a.887.887 0 0 1-.628 1.515Z" fill="#fff"/></svg>
            </button>
            <div class="tw-w-full tw-h-[0px] tw-relative tw-bg-white tw-text-black tw-rounded-[5px] tw-z-[1] tw-overflow-hidden" style="padding-bottom: {{ (460 / 400) * 100 }}%;">
                <iframe class="tw-absolute tw-w-full tw-h-full tw-inset-0 tw-p-0 tw-overflow-hidden"></iframe>
            </div>
        </div>
        <div class="tw-absolute tw-inset-0 tw-bg-black tw-opacity-50 tw-z-[1]"></div>
    </div>
{% endif %}
