{% import "_includes/forms" as forms %}

{{ forms.textField({
    label: "Limit"|t('app'),
    instructions: "Limit the number of selectable ads."|t('site'),
    id: 'limit',
    name: 'limit',
    value: field.limit,
    size: 2,
    errors: field.getErrors('limit')
}) }}

{{ forms.checkboxSelectField({
    label: "Adspace Containers"|t('site'),
    instructions: "The adspace containers to select ads from."|t('site'),
    id: 'containers',
    name: 'containers',
    options: [{
        label: 'Banner',
        value: 'banner'
    }, {
        label: 'Shoutout',
        value: 'shoutout'
    }, {
        label: 'Popup',
        value: 'popup'
    }],
    values: field.containers,
    showAllOption: true,
}) }}

{{ forms.checkboxSelectField({
    label: "Playground Sites"|t('site'),
    instructions: "The playground sites to select ads from."|t('site'),
    id: 'siteSources',
    name: 'siteSources',
    options: sites|map(site => {
        label: site.name,
        value: site.uid
    }),
    values: field.siteSources,
    showAllOption: true,
}) }}
