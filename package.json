{
  "name": "escape-info-plugin",
  "version": "1.0.0",
  "repository": "git@bitbucket.org:vaersaagod/escape-info-playground-plugin.git",
  "author": "Mats Mikkel Rummelhoff <mail@mmikkel.no>",
  "license": "MIT",
  "private": true,
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "start": "parcel watch --no-cache",
    "build": "parcel build --no-cache"
  },
  "targets": {
    "playground.css": {
      "source": [
        "./src/web/assets/src/playground/playground.scss"
      ],
      "distDir": "./src/web/assets/dist"
    },
    "adspace-shoutouts.js": {
      "source": [
        "./src/web/assets/src/playground/adspace-shoutouts.js"
      ],
      "distDir": "./src/web/assets/dist/adspace"
    },
    "adspace-popup.js": {
      "source": [
        "./src/web/assets/src/playground/adspace-popup.js"
      ],
      "distDir": "./src/web/assets/dist/adspace"
    },
    "adspace-select-field.js": {
      "source": [
        "./src/web/assets/src/cp/adspace-select-field.js",
        "./src/web/assets/src/cp/adspace-select-field.css"
      ],
      "distDir": "./src/web/assets/dist/cp"
    }
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^6.5.1",
    "cssnano": "^6.0.1",
    "dotenv": "^10.0.0",
    "http-proxy-middleware": "^2.0.1",
    "parcel": "^2.8.3",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.0.8"
  },
  "dependencies": {
    "flickity": "^2.3.0"
  }
}
